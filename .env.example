# Copier ce fichier en `.env` (non versionné) et renseigner ta clé si tu en as une.
# Clé gratuite à créer sur https://pokemontcg.io — accélère fortement la
# synchronisation du cache local de cartes (data/db/splitdex.sqlite3).
POKEMONTCG_API_KEY=

# Clé gratuite à créer sur https://roboflow.com — utilisée une seule fois pour
# télécharger le dataset d'entraînement du modèle de détection de cartes
# (backend/app/scripts/train_card_yolo.py). Pas utilisée à l'exécution normale.
ROBOFLOW_API_KEY=
