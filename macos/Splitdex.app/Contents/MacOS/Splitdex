#!/bin/bash
# Splitdex.app — lanceur macOS.
# Démarre le serveur local (via run.sh) s'il ne tourne pas déjà, attend qu'il
# réponde, puis ouvre l'application dans Chrome (repli : navigateur par défaut).
# Lancé depuis le Finder/Dock, l'environnement est minimal : on rétablit un PATH
# qui inclut Homebrew (Intel /usr/local, Apple Silicon /opt/homebrew).

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

EXEC_DIR="$(cd "$(dirname "$0")" && pwd)"

# Un dossier est la racine du projet s'il contient run.sh ET le backend.
is_project() { [ -f "$1/run.sh" ] && [ -f "$1/backend/app/main.py" ]; }

# Localise la racine du projet, de la méthode la plus fiable à la plus large :
find_project() {
  # 1) Remonter depuis l'emplacement du .app (fonctionne tant que l'app est
  #    quelque part DANS l'arborescence du projet, à n'importe quelle profondeur).
  local dir="$EXEC_DIR"
  while [ -n "$dir" ] && [ "$dir" != "/" ]; do
    is_project "$dir" && { printf '%s' "$dir"; return 0; }
    dir="$(dirname "$dir")"
  done
  # 2) Emplacements usuels si l'app a été copiée HORS du projet (ex: /Applications).
  local base
  for base in "$HOME/splitdex" "$HOME/Splitdex" "$HOME/Downloads/splitdex" \
              "$HOME/Downloads/splitdex-main" "$HOME/Desktop/splitdex"; do
    is_project "$base" && { printf '%s' "$base"; return 0; }
  done
  # 3) Dernier recours : recherche bornée sous le dossier personnel.
  local f d
  while IFS= read -r f; do
    d="$(dirname "$f")"
    is_project "$d" && { printf '%s' "$d"; return 0; }
  done < <(find "$HOME" -maxdepth 4 -name run.sh 2>/dev/null)
  return 1
}

PROJECT="$(find_project)"
if [ -z "$PROJECT" ]; then
  osascript -e 'display alert "Splitdex" message "Projet Splitdex introuvable. Placez le dossier du projet (celui qui contient run.sh) dans votre dossier personnel, par exemple ~/splitdex, puis relancez."'
  exit 1
fi

cd "$PROJECT" || exit 1

URL="http://localhost:8000"
LOG="$PROJECT/splitdex-server.log"

server_up() { curl -fsS -m 2 "$URL/api/health" >/dev/null 2>&1; }

if ! server_up; then
  # Premier lancement : run.sh installe les dépendances puis démarre uvicorn.
  # Détaché, sa sortie va dans le journal.
  nohup ./run.sh >"$LOG" 2>&1 &
  for _ in $(seq 1 120); do
    server_up && break
    sleep 1
  done
fi

if server_up; then
  open -a "Google Chrome" "$URL" 2>/dev/null || open "$URL"
else
  osascript -e 'display alert "Splitdex" message "Le serveur n’a pas démarré à temps. Consultez splitdex-server.log à la racine du projet."'
  open -t "$LOG" 2>/dev/null || true
  exit 1
fi
